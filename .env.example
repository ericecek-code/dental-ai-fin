# Dental AI — Production environment variables (.env)
# Tento subor NIKDY necommituj (.gitignore ho blokuje).

# --- Backend FastAPI ---
APP_NAME="Dental AI"
APP_VERSION="0.1.0"
PORT=8000

# --- Upload limity ---
UPLOAD_MAX_SIZE_MB=50

# --- CORS — povolene origins pre frontend ---
# JSON list alebo comma-separated. Pridaj domeny podla potreby.
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:4173"]'

# --- YOLOv8 weights ---
WEIGHTS_PATH=/app/weights/yolov8x_dental.pt

# --- Bezpecnost ---
# API token pre externy pristup (Hermes, monitoring, ine automaty).
# Generuj s: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ak je nastavený, /analyze a /results endpointy vyžadujú token.
API_TOKEN=replace-with-generated-token

# --- Logovanie ---
LOG_LEVEL=INFO
