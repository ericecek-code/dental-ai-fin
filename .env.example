# Dental AI — Production environment variables (.env)
# Tento súbor NIKDY necommituj — .gitignore blokuje .env a .env.*

# --- Backend FastAPI ---
APP_NAME="Dental AI"
APP_VERSION="0.1.0"
PORT=8000

# --- Upload limity ---
UPLOAD_MAX_SIZE_MB=50

# --- Runtime dáta (uploady, výstupy, reporty, SQLite) ---
# Prázdne = systémový temp adresár /dental-ai
# DATA_DIR=/tmp/dental-ai

# --- YOLOv8 weights ---
# Prázdne = backend/weights/yolov8x_dental.pt
# MODEL_PATH=/app/backend/weights/yolov8x_dental.pt

# --- CORS — povolené origins pre frontend ---
# JSON list alebo comma-separated. Pridaj domény podľa potreby.
CORS_ORIGINS='["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173"]'

# --- Bezpečnosť ---
# API token pre externý prístup (Hermes, monitoring, iné automaty).
# Generuj s: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Prázdne = autentifikácia vypnutá (dev/demo). Nastavené = vyžaduje X-API-Key.
API_TOKEN=

# --- Gemini Vision (voliteľné) ---
# Bez kľúča sa /vision/analyze vráti s chybou, ostatné endpointy fungujú.
GEMINI_API_KEY=

# --- Logovanie ---
LOG_LEVEL=INFO
